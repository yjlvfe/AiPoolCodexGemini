#!/usr/bin/env bash
# ==============================================================================
# ag - Unified Gemini / Antigravity Multi-Account CLI
# ==============================================================================
set -euo pipefail

STORE_DIR="${AG_ACCOUNT_STORE:-$HOME/.antigravity-accounts}"
ACTIVE_FILE="$STORE_DIR/active"
# Dynamically locate antigravity-account-switch
if [ -z "${SWITCH_BIN:-}" ]; then
    _SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -x "$_SELF_DIR/antigravity-account-switch" ]; then
        SWITCH_BIN="$_SELF_DIR/antigravity-account-switch"
    elif [ -x "$HOME/.local/bin/antigravity-account-switch" ]; then
        SWITCH_BIN="$HOME/.local/bin/antigravity-account-switch"
    elif [ -x "/usr/local/bin/antigravity-account-switch" ]; then
        SWITCH_BIN="/usr/local/bin/antigravity-account-switch"
    else
        SWITCH_BIN="$(command -v antigravity-account-switch 2>/dev/null || echo "antigravity-account-switch")"
    fi
fi

list_accounts() {
    echo "=========================================================="
    echo " 🟢 Registered Gemini / Antigravity Accounts:"
    echo "=========================================================="
    active_acc=""
    if [ -f "$ACTIVE_FILE" ]; then
        active_acc=$(cat "$ACTIVE_FILE" | tr -d '[:space:]')
    fi
    found=0
    for d in "$STORE_DIR"/*; do
        if [ -d "$d" ]; then
            num=$(basename "$d")
            if [[ "$num" =~ ^[0-9]+$ ]]; then
                found=1
                email="Unknown"
                meta="$d/metadata.json"
                if [ -f "$meta" ]; then
                    email=$(python3 -c "import json; print(json.load(open('$meta')).get('email','Unknown'))" 2>/dev/null || echo "Unknown")
                fi
                if [ "$num" = "$active_acc" ]; then
                    echo -e "  [#$num] $email \033[1;32m(ACTIVE ✓)\033[0m"
                else
                    echo -e "  [#$num] $email"
                fi
            fi
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "  No registered accounts found in $STORE_DIR"
    fi
    echo "=========================================================="
    echo "To switch: ag <num> (e.g. ag 2) | To inspect: agusage"
    echo "=========================================================="
}

cmd="${1:-}"

# If no args or list
if [ -z "$cmd" ] || [ "$cmd" = "list" ] || [ "$cmd" = "-l" ] || [ "$cmd" = "--list" ]; then
    list_accounts
    exit 0
fi

# Usage
if [ "$cmd" = "usage" ] || [ "$cmd" = "-u" ] || [ "$cmd" = "--usage" ]; then
    "$SWITCH_BIN" --usage 2>/dev/null || true
    exit 0
fi

# Number switch (e.g. 'ag 2')
if [[ "$cmd" =~ ^[0-9]+$ ]]; then
    exec "$SWITCH_BIN" "$cmd"
fi

# Switch subcommand
if [ "$cmd" = "switch" ]; then
    target_num="${2:-}"
    if [ -z "$target_num" ]; then
        echo "Error: Specify account number. Example: ag switch 2"
        exit 1
    fi
    exec "$SWITCH_BIN" "$target_num"
fi

# Remove / Delete Account
if [ "$cmd" = "rm" ] || [ "$cmd" = "remove" ] || [ "$cmd" = "del" ]; then
    target_num="${2:-}"
    if [ -z "$target_num" ]; then
        echo "Error: Specify account number to remove. Example: ag rm 2"
        exit 1
    fi
    if [ -d "$STORE_DIR/$target_num" ]; then
        rm -rf "$STORE_DIR/$target_num"
        echo "✓ Removed Gemini account #$target_num"
        if [ -f "$ACTIVE_FILE" ] && [ "$(cat "$ACTIVE_FILE" | tr -d '[:space:]')" = "$target_num" ]; then
            rm -f "$ACTIVE_FILE"
            echo "⚠️ Active account was removed. Please switch to another account: ag 1"
        fi
    else
        echo "Account #$target_num does not exist."
    fi
    exit 0
fi

# Clean duplicates
if [ "$cmd" = "clean" ]; then
    echo "🧹 Scanning for duplicate Gemini accounts..."
    python3 -c "
import os, json
store = os.environ.get('AG_ACCOUNT_STORE', os.path.expanduser('~/.antigravity-accounts'))
seen = {}
for d in sorted(os.listdir(store), key=lambda x: int(x) if x.isdigit() else 999):
    dp = os.path.join(store, d)
    if not (os.path.isdir(dp) and d.isdigit()): continue
    meta_p = os.path.join(dp, 'metadata.json')
    email = None
    if os.path.exists(meta_p):
        try: email = json.load(open(meta_p)).get('email')
        except: pass
    if not email:
        tok_p = os.path.join(dp, 'antigravity-oauth-token')
        if os.path.exists(tok_p):
            try: email = json.load(open(tok_p)).get('token', {}).get('email')
            except: pass
    if email:
        if email in seen:
            print(f'Removing duplicate account #{d} ({email}) - original is #{seen[email]}')
            import shutil; shutil.rmtree(dp)
        else:
            seen[email] = d
print('✓ Duplicate cleanup complete.')
"
    exit 0
fi

# Add Account (or interactive login)
if [ "$cmd" = "add" ]; then
    input_file="${2:-}"
    highest=0
    for f in "$STORE_DIR"/*; do
        b=$(basename "$f")
        if [[ "$b" =~ ^[0-9]+$ ]] && [ "$b" -gt "$highest" ]; then
            highest=$b
        fi
    done
    next=$((highest + 1))
    
    if [ -n "$input_file" ] && [ -f "$input_file" ]; then
        target_dir="$STORE_DIR/$next"
        mkdir -p "$target_dir"
        cp "$input_file" "$target_dir/antigravity-oauth-token"
        chmod 600 "$target_dir/antigravity-oauth-token"
        echo "✓ Account data imported as Account #$next"
        echo "Activating..."
        exec "$SWITCH_BIN" "$next"
    else
        echo "=========================================================="
        echo " ➕ Adding New Gemini / Antigravity Account (#$next)"
        echo "=========================================================="
        echo "Starting official enrollment session..."
        exec "$SWITCH_BIN" "$next"
    fi
fi

exec "$SWITCH_BIN" "$@"
