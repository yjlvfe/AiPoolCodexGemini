#!/usr/bin/env bash
# ==============================================================================
# cx - Unified Codex / ChatGPT Multi-Account CLI
# ==============================================================================
set -euo pipefail

STORE_DIR="${CODEX_ACCOUNT_STORE:-$HOME/.codex-accounts}"
ACTIVE_FILE="$STORE_DIR/active"
# Dynamically locate codex-account-switch
if [ -z "${SWITCH_BIN:-}" ]; then
    _SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -x "$_SELF_DIR/codex-account-switch" ]; then
        SWITCH_BIN="$_SELF_DIR/codex-account-switch"
    elif [ -x "$HOME/.local/bin/codex-account-switch" ]; then
        SWITCH_BIN="$HOME/.local/bin/codex-account-switch"
    elif [ -x "/usr/local/bin/codex-account-switch" ]; then
        SWITCH_BIN="/usr/local/bin/codex-account-switch"
    else
        SWITCH_BIN="$(command -v codex-account-switch 2>/dev/null || echo "codex-account-switch")"
    fi
fi

list_accounts() {
    echo "=========================================================="
    echo " 🟣 Registered Codex / ChatGPT Accounts:"
    echo "=========================================================="
    active_acc=""
    if [ -f "$ACTIVE_FILE" ]; then
        active_acc=$(cat "$ACTIVE_FILE" | tr -d '[:space:]')
    fi
    found=0
    for d in "$STORE_DIR"/*; do
        b=$(basename "$d")
        if [[ "$b" =~ ^[0-9]+$ ]]; then
            found=1
            email="Unknown"
            auth_file="$d"
            if [ -d "$d" ] && [ -f "$d/auth.json" ]; then
                auth_file="$d/auth.json"
            fi
            if [ -f "$auth_file" ]; then
                email=$(python3 -c "import json; print(json.load(open('$auth_file')).get('email', json.load(open('$auth_file')).get('user', 'Account #$b')))" 2>/dev/null || echo "Account #$b")
            fi
            if [ "$b" = "$active_acc" ]; then
                echo -e "  [#$b] $email \033[1;32m(ACTIVE ✓)\033[0m"
            else
                echo -e "  [#$b] $email"
            fi
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "  No registered accounts found in $STORE_DIR"
    fi
    echo "=========================================================="
    echo "To switch: c <num> (e.g. c 3) | To inspect: cusage"
    echo "=========================================================="
}

cmd="${1:-}"

# If no args or list
if [ -z "$cmd" ] || [ "$cmd" = "list" ] || [ "$cmd" = "-l" ] || [ "$cmd" = "--list" ]; then
    list_accounts
    exit 0
fi

# Usage
if [ "$cmd" = "usage" ] || [ "$cmd" = "-u" ] || [ "$cmd" = "--usage" ]; then
    "$SWITCH_BIN" --usage 2>/dev/null || true
    exit 0
fi

# Number switch (e.g. 'cx 3')
if [[ "$cmd" =~ ^[0-9]+$ ]]; then
    exec "$SWITCH_BIN" switch "$cmd"
fi

# Switch subcommand
if [ "$cmd" = "switch" ]; then
    target_num="${2:-}"
    if [ -z "$target_num" ]; then
        echo "Error: Specify account number. Example: cx switch 3"
        exit 1
    fi
    exec "$SWITCH_BIN" switch "$target_num"
fi

# Remove / Delete Account
if [ "$cmd" = "rm" ] || [ "$cmd" = "remove" ] || [ "$cmd" = "del" ]; then
    target_num="${2:-}"
    if [ -z "$target_num" ]; then
        echo "Error: Specify account number to remove. Example: cx rm 2"
        exit 1
    fi
    if [ -d "$STORE_DIR/$target_num" ]; then
        rm -rf "$STORE_DIR/$target_num"
        echo "✓ Removed Codex account #$target_num"
        if [ -f "$ACTIVE_FILE" ] && [ "$(cat "$ACTIVE_FILE" | tr -d '[:space:]')" = "$target_num" ]; then
            rm -f "$ACTIVE_FILE"
            echo "⚠️ Active account was removed. Please switch to another account: cx switch 1"
        fi
    else
        echo "Account #$target_num does not exist."
    fi
    exit 0
fi

# Clean duplicates
if [ "$cmd" = "clean" ]; then
    echo "🧹 Scanning for duplicate Codex accounts..."
    python3 -c "
import os, json
store = os.environ.get('CODEX_ACCOUNT_STORE', os.path.expanduser('~/.codex-accounts'))
seen = {}
for d in sorted(os.listdir(store), key=lambda x: int(x) if x.isdigit() else 999):
    dp = os.path.join(store, d)
    if not (os.path.isdir(dp) and d.isdigit()): continue
    auth_p = os.path.join(dp, 'auth.json')
    email = None
    if os.path.exists(auth_p):
        try: email = json.load(open(auth_p)).get('email')
        except: pass
    if email:
        if email in seen:
            print(f'Removing duplicate account #{d} ({email}) - original is #{seen[email]}')
            import shutil; shutil.rmtree(dp)
        else:
            seen[email] = d
print('✓ Duplicate cleanup complete.')
"
    exit 0
fi

# Add Account (or interactive login)
if [ "$cmd" = "add" ]; then
    input_file="${2:-}"
    highest=0
    for f in "$STORE_DIR"/*; do
        b=$(basename "$f")
        if [[ "$b" =~ ^[0-9]+$ ]] && [ "$b" -gt "$highest" ]; then
            highest=$b
        fi
    done
    next=$((highest + 1))
    
    if [ -n "$input_file" ] && [ -f "$input_file" ]; then
        target_dir="$STORE_DIR/$next"
        mkdir -p "$target_dir"
        cp "$input_file" "$target_dir/auth.json"
        chmod 600 "$target_dir/auth.json"
        echo "✓ Account data imported as Account #$next"
        echo "Activating..."
        exec "$SWITCH_BIN" switch "$next"
    else
        echo "=========================================================="
        echo " ➕ Adding New Codex / ChatGPT Account (#$next)"
        echo "=========================================================="
        echo "Starting official device-code authorization session..."
        exec "$SWITCH_BIN" switch "$next"
    fi
fi

exec "$SWITCH_BIN" "$@"
