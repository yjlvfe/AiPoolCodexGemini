#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ACCOUNT_STORE=${CODEX_ACCOUNT_STORE:-$HOME/.codex-accounts}
SHARED_HOME=${CODEX_SHARED_HOME:-${CODEX_HOME:-$HOME/.codex}}
CODEX_BIN=${CODEX_BIN:-$(command -v codex 2>/dev/null || true)}
QUERY_BIN=${CODEX_ACCOUNT_QUERY_BIN:-/usr/local/libexec/codex-account-query}
WRAPPER_DIR=${CODEX_WRAPPER_DIR:-/usr/local/bin}
AUTH_FILE=$SHARED_HOME/auth.json
ACTIVE_FILE=$ACCOUNT_STORE/active
LOCK_FILE=$ACCOUNT_STORE/switch.lock
OUTPUT_IS_TTY=0
[[ -t 1 ]] && OUTPUT_IS_TTY=1

export CODEX_SHARED_HOME=$SHARED_HOME

normalize_email() {
  local email=${1-} target
  local email_pattern='^[^[:space:]@]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$'
  email=${email//\\@/@}
  if [[ $email == \[* && $email == *mailto:* && $email == *\) ]]; then
    target=${email#*\]\(mailto:}
    target=${target%\)}
    email=$target
  elif [[ $email == mailto:* ]]; then
    email=${email#mailto:}
  fi
  if [[ $email =~ $email_pattern ]]; then
    printf '%s' "$email"
  fi
}

die() {
  printf 'codex-account-switch: %s\n' "$*" >&2
  exit 1
}

validate_account() {
  local raw=${1-}
  [[ $raw =~ ^[1-9][0-9]*$ ]] || die 'account number must be a positive integer without leading zeroes'
  REPLY=$raw
}

require_regular_not_symlink() {
  local path=$1 label=$2
  [[ -f $path && ! -L $path ]] || die "$label is missing or unsafe"
}

wait_for_auth_file() {
  local path=$1 attempts=0
  while (( attempts < 40 )); do
    if [[ -f $path && ! -L $path && -s $path ]]; then
      chmod 600 -- "$path"
      return 0
    fi
    sleep 0.05
    attempts=$((attempts + 1))
  done
  return 1
}

backup_existing() {
  local path=$1 backup timestamp
  [[ -e $path || -L $path ]] || return 0
  require_regular_not_symlink "$path" 'backup source'
  timestamp=$(date -u +%Y%m%dT%H%M%S.%N)
  backup=${path}.bak.${timestamp}.$$
  install -m 600 -- "$path" "$backup"
}

backup_wrapper() {
  local path=$1 backup timestamp
  [[ -e $path || -L $path ]] || return 0
  [[ ! -d $path ]] || die 'wrapper target is a directory'
  timestamp=$(date -u +%Y%m%dT%H%M%S.%N)
  backup=${path}.bak.${timestamp}.$$
  cp -a -- "$path" "$backup"
  [[ -L $backup ]] || chmod 600 -- "$backup"
}

atomic_install() {
  local source=$1 destination=$2 directory temporary
  require_regular_not_symlink "$source" 'authentication source'
  directory=${destination%/*}
  [[ $directory != "$destination" && -d $directory && ! -L $directory ]] || die 'destination directory is missing or unsafe'
  if [[ -e $destination || -L $destination ]]; then
    require_regular_not_symlink "$destination" 'authentication destination'
  fi
  temporary=$(mktemp "$directory/.codex-account.tmp.XXXXXX")
  install -m 600 -- "$source" "$temporary"
  mv -f -- "$temporary" "$destination"
  chmod 600 -- "$destination"
}

atomic_install_derived() {
  local source=$1 destination=$2 directory temporary
  require_regular_not_symlink "$source" 'derived data source'
  directory=${destination%/*}
  [[ -d $directory && ! -L $directory ]] || die 'derived data directory is missing or unsafe'
  if [[ -e $destination || -L $destination ]]; then
    require_regular_not_symlink "$destination" 'derived data destination'
  fi
  temporary=$(mktemp "$directory/.codex-derived.tmp.XXXXXX")
  install -m 600 -- "$source" "$temporary"
  mv -f -- "$temporary" "$destination"
  chmod 600 -- "$destination"
}

atomic_write_text() {
  local value=$1 destination=$2 directory temporary
  directory=${destination%/*}
  [[ $directory != "$destination" && -d $directory && ! -L $directory ]] || die 'marker directory is missing or unsafe'
  if [[ -e $destination || -L $destination ]]; then
    require_regular_not_symlink "$destination" 'marker destination'
  fi
  temporary=$(mktemp "$directory/.codex-account.marker.XXXXXX")
  printf '%s\n' "$value" > "$temporary"
  chmod 600 -- "$temporary"
  mv -f -- "$temporary" "$destination"
  chmod 600 -- "$destination"
}

read_active() {
  local active
  require_regular_not_symlink "$ACTIVE_FILE" 'active account marker'
  active=$(<"$ACTIVE_FILE")
  validate_account "$active"
  printf '%s' "$REPLY"
}

ensure_private_store() {
  [[ ! -L $ACCOUNT_STORE ]] || die 'account store must not be a symbolic link'
  install -d -m 700 -- "$ACCOUNT_STORE"
  chmod 700 -- "$ACCOUNT_STORE"
  if [[ ! -e $LOCK_FILE && ! -L $LOCK_FILE ]]; then
    : > "$LOCK_FILE"
  fi
  require_regular_not_symlink "$LOCK_FILE" 'switch lock'
  chmod 600 -- "$LOCK_FILE"
}

ensure_account_directory() {
  local number=$1 directory=$ACCOUNT_STORE/$1
  [[ ! -L $directory ]] || die 'account directory must not be a symbolic link'
  install -d -m 700 -- "$directory"
  chmod 700 -- "$directory"
}

save_outgoing() {
  local number=$1
  require_regular_not_symlink "$AUTH_FILE" 'live Codex authentication'
  [[ -s $AUTH_FILE ]] || die 'live Codex authentication is empty'
  ensure_account_directory "$number"
  atomic_install "$AUTH_FILE" "$ACCOUNT_STORE/$number/auth.json"
}

reconcile_live_account() {
  local marked live_info live_email candidate metadata_email match= matches=0
  marked=$(read_active 2>/dev/null || true)
  [[ -f $AUTH_FILE && ! -L $AUTH_FILE && -s $AUTH_FILE ]] || { printf '%s' "$marked"; return; }
  live_info=$(CODEX_HOME=$SHARED_HOME CODEX_BIN=$CODEX_BIN "$QUERY_BIN" account 2>/dev/null || true)
  live_email=$(normalize_email "$(jq -r '.email // empty' <<<"$live_info" 2>/dev/null || true)")
  if [[ -z $live_email ]]; then
    printf '%s' "$marked"
    return
  fi
  while IFS= read -r candidate; do
    metadata_email=$(normalize_email "$(jq -r '.email // empty' "$ACCOUNT_STORE/$candidate/metadata.json" 2>/dev/null || true)")
    if [[ $metadata_email == "$live_email" ]]; then match=$candidate; matches=$((matches + 1)); fi
  done < <(account_slots)
  if (( matches != 1 )); then
    printf 'STATE MISMATCH: live account identity does not resolve uniquely\n' >&2
    printf '%s' "$marked"
    return
  fi
  if [[ $marked != "$match" ]]; then atomic_write_text "$match" "$ACTIVE_FILE"; fi
  atomic_install "$AUTH_FILE" "$ACCOUNT_STORE/$match/auth.json"
  printf '%s' "$match"
}

verify_live_identity() {
  local expected=$1 live_info expected_email live_email expected_plan live_plan
  expected_email=$(normalize_email "$(jq -r '.email // empty' <<<"$expected")")
  expected_plan=$(jq -r '.planType // empty' <<<"$expected")
  live_info=$(CODEX_HOME=$SHARED_HOME CODEX_BIN=$CODEX_BIN "$QUERY_BIN" account 2>/dev/null) || return 1
  live_email=$(normalize_email "$(jq -r '.email // empty' <<<"$live_info")")
  live_plan=$(jq -r '.planType // empty' <<<"$live_info")
  [[ $live_email == "$expected_email" && $live_plan == "$expected_plan" ]]
}

read_account_identity_with_retry() {
  local home=$1 result attempt
  for attempt in 1 2 3 4 5; do
    result=$(CODEX_HOME=$home CODEX_BIN=$CODEX_BIN "$QUERY_BIN" account 2>/dev/null || true)
    if jq -e 'type == "object" and .status == "OK" and (.email | type == "string") and (.email | length > 0) and (.planType == null or (.planType | type == "string"))' <<<"$result" >/dev/null 2>&1; then
      printf '%s\n' "$result"
      return 0
    fi
    sleep 0.2
  done
  return 1
}

write_wrapper() {
  local name=$1 operation=$2 number=$3 destination temporary
  [[ -d $WRAPPER_DIR && ! -L $WRAPPER_DIR ]] || die 'wrapper directory is missing or unsafe'
  destination=$WRAPPER_DIR/$name
  temporary=$(mktemp "$WRAPPER_DIR/.codex-wrapper.XXXXXX")
  {
    printf '%s\n' '#!/usr/bin/env bash' 'set -Eeuo pipefail'
    printf 'exec "${CODEX_ACCOUNT_SWITCH_BIN:-/usr/local/bin/codex-account-switch}" %q %q "$@"\n' "$operation" "$number"
  } > "$temporary"
  chmod 755 -- "$temporary"
  if [[ -f $destination && ! -L $destination ]] && cmp -s -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    chmod 755 -- "$destination"
    return 0
  fi
  backup_wrapper "$destination"
  mv -f -- "$temporary" "$destination"
  chmod 755 -- "$destination"
}

ensure_account_wrappers() {
  local number=$1
  write_wrapper "c$number" switch "$number"
  write_wrapper "C$number" switch "$number"
}


perform_new_login() (
  set -Eeuo pipefail
  local number=$1 rollback_auth rollback_active rollback_target target_auth target_existed=0 login_home
  local committed=0 cleanup_status account_result live_result metadata_tmp email plan recovery timestamp
  rollback_auth=$(mktemp "$ACCOUNT_STORE/.rollback.auth.XXXXXX")
  rollback_active=$(mktemp "$ACCOUNT_STORE/.rollback.active.XXXXXX")
  install -m 600 -- "$AUTH_FILE" "$rollback_auth"
  install -m 600 -- "$ACTIVE_FILE" "$rollback_active"
  ensure_account_directory "$number"
  target_auth=$ACCOUNT_STORE/$number/auth.json
  rollback_target=$(mktemp "$ACCOUNT_STORE/.rollback.target.XXXXXX")
  if [[ -e $target_auth || -L $target_auth ]]; then
    require_regular_not_symlink "$target_auth" 'stored target authentication'
    install -m 600 -- "$target_auth" "$rollback_target"
    target_existed=1
  fi
  backup_existing "$AUTH_FILE"
  backup_existing "$ACTIVE_FILE"
  login_home=$(mktemp -d "/tmp/codex-login-$number.XXXXXX")
  chmod 700 -- "$login_home"
  printf '%s\n' 'cli_auth_credentials_store = "file"' > "$login_home/config.toml"
  chmod 600 -- "$login_home/config.toml"

  cleanup_new_login() {
    cleanup_status=$?
    trap - EXIT INT TERM HUP
    if (( committed == 0 )); then
      if [[ -f $login_home/auth.json && ! -L $login_home/auth.json && -s $login_home/auth.json ]]; then
        timestamp=$(date -u +%Y%m%dT%H%M%S.%N)
        recovery=$target_auth.login-failed.$timestamp.$$
        install -m 600 -- "$login_home/auth.json" "$recovery"
      fi
      atomic_install "$rollback_auth" "$AUTH_FILE"
      atomic_install "$rollback_active" "$ACTIVE_FILE"
      if (( target_existed == 1 )); then
        atomic_install "$rollback_target" "$target_auth"
      else
        rm -f -- "$target_auth"
      fi
    fi
    rm -f -- "$rollback_auth" "$rollback_active" "$rollback_target"
    safe_remove_login_home "$login_home"
    exit "$cleanup_status"
  }

  trap cleanup_new_login EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  CODEX_HOME=$login_home "$CODEX_BIN" login --device-auth
  wait_for_auth_file "$login_home/auth.json" || die 'new isolated Codex authentication is missing'
  CODEX_HOME=$login_home "$CODEX_BIN" login status >/dev/null 2>&1 || die 'new isolated Codex login status failed'
  atomic_install "$login_home/auth.json" "$target_auth"
  account_result=$(read_account_identity_with_retry "$login_home") || die 'new isolated account/read did not return identity'
  wait_for_auth_file "$login_home/auth.json" || die 'new isolated authentication was not persisted'
  email=$(normalize_email "$(jq -r '.email' <<<"$account_result")")
  plan=$(jq -r '.planType // empty' <<<"$account_result")
  [[ -n $email ]] || die 'new isolated account identity is missing'
  account_result=$(jq -c --arg email "$email" '.email = $email' <<<"$account_result")

  atomic_install "$login_home/auth.json" "$target_auth"
  atomic_install "$target_auth" "$AUTH_FILE"
  live_result=$(read_account_identity_with_retry "$SHARED_HOME") || die 'new live account/read did not return identity'
  [[ $(normalize_email "$(jq -r '.email // empty' <<<"$live_result")") == "$email" ]] || die 'new live account identity mismatch'
  [[ $(jq -r '.planType // empty' <<<"$live_result") == "$plan" ]] || die 'new live account plan mismatch'
  metadata_tmp=$(mktemp "$ACCOUNT_STORE/$number/.metadata.XXXXXX")
  jq -c --argjson updatedAt "$(date +%s)" '{accountType:.accountType,email:.email,planType:.planType,status:"OK",lastChecked:$updatedAt,updatedAt:$updatedAt}' <<<"$account_result" > "$metadata_tmp"
  chmod 600 -- "$metadata_tmp"
  atomic_install_derived "$metadata_tmp" "$ACCOUNT_STORE/$number/metadata.json"
  atomic_write_text "$number" "$ACTIVE_FILE"
  committed=1
)

safe_remove_login_home() {
  local path=$1
  case "$path" in
    /tmp/codex-login-[1-9]*.*)
      [[ -d $path && ! -L $path ]] && rm -rf -- "$path"
      ;;
  esac
}

safe_remove_query_home() {
  local path=$1
  case "$path" in
    /tmp/codex-account-query.[1-9]*.*)
      [[ -d $path && ! -L $path ]] && rm -rf -- "$path"
      ;;
  esac
}

query_result_is_safe() {
  jq -e '
    type == "object" and
    ((.status // "OK") == "OK" or .status == "SIGNED OUT" or .status == "INVALID AUTH" or .status == "CHECK FAILED" or .status == "SERVER INVALIDATED") and
    (.accountType == null or (.accountType | type == "string")) and
    (.email == null or (.email | type == "string")) and
    (.planType == null or (.planType | type == "string")) and
    (.windows == null or (.windows | type == "array"))
  ' >/dev/null 2>&1
}

finalize_query_result() {
  local number=$1 query_output=$2 cached checked_at normalized_email metadata_tmp
  checked_at=$(date +%s)
  cached=$(metadata_fallback "$number")
  query_output=$(jq -c --argjson cached "$cached" '
    .status = (.status // "OK") |
    .email = (.email // $cached.email) |
    .planType = (.planType // $cached.planType) |
    .accountType = (.accountType // $cached.accountType) |
    .windows = (.windows // [])
  ' <<<"$query_output")
  normalized_email=$(normalize_email "$(jq -r '.email // empty' <<<"$query_output")")
  query_output=$(jq -c --arg email "$normalized_email" '.email = (if $email == "" then null else $email end)' <<<"$query_output")
  metadata_tmp=$(mktemp "$ACCOUNT_STORE/$number/.metadata.XXXXXX")
  jq -c --argjson checkedAt "$checked_at" '
    {accountType:.accountType,email:.email,planType:.planType,status:.status,lastChecked:$checkedAt,updatedAt:$checkedAt}
  ' <<<"$query_output" > "$metadata_tmp"
  chmod 600 -- "$metadata_tmp"
  atomic_install_derived "$metadata_tmp" "$ACCOUNT_STORE/$number/metadata.json"
  printf '%s\n' "$query_output"
}

query_account_shared() (
  set -Eeuo pipefail
  local number=$1 mode=$2 stored query_output query_status=0 current cached
  validate_account "$number"
  [[ $mode == account || $mode == health || $mode == usage ]] || return 64
  [[ -x $QUERY_BIN ]] || return 1
  stored=$ACCOUNT_STORE/$number/auth.json
  require_regular_not_symlink "$AUTH_FILE" 'live Codex authentication'
  [[ -s $AUTH_FILE ]] || return 1

  if [[ ${LOCK_HELD:-0} != 1 ]]; then exec 8<>"$LOCK_FILE"; flock -x 8; fi
  current=$(read_active 2>/dev/null || true)
  if [[ $current != "$number" ]]; then
    if [[ ${LOCK_HELD:-0} != 1 ]]; then flock -u 8; exec 8>&-; fi
    return 75
  fi

  atomic_install "$AUTH_FILE" "$stored"
  set +e
  query_output=$(CODEX_HOME=$SHARED_HOME CODEX_BIN=$CODEX_BIN "$QUERY_BIN" "$mode" 2>/dev/null)
  query_status=$?
  set -e

  if (( query_status == 0 )) && query_result_is_safe <<<"$query_output"; then
    if [[ $(jq -r '.status // "OK"' <<<"$query_output") == OK ]]; then
      wait_for_auth_file "$AUTH_FILE" || die 'refreshed live Codex authentication was not persisted'
      atomic_install "$AUTH_FILE" "$stored"
    fi
    finalize_query_result "$number" "$query_output"
  else
    cached=$(metadata_fallback "$number")
    jq -c '. + {status:"CHECK FAILED",windows:[]}' <<<"$cached"
  fi
  if [[ ${LOCK_HELD:-0} != 1 ]]; then flock -u 8; exec 8>&-; fi
)

query_account_isolated() (
  set -Eeuo pipefail
  local number=$1 mode=$2 stored temp_home original query_output query_status=0
  local cached status current
  validate_account "$number"
  [[ $mode == account || $mode == health || $mode == usage ]] || return 64
  [[ -x $QUERY_BIN ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  stored=$ACCOUNT_STORE/$number/auth.json
  require_regular_not_symlink "$stored" 'stored account authentication'
  [[ -s $stored ]] || return 1
  ensure_private_store

  temp_home=$(mktemp -d "/tmp/codex-account-query.$number.XXXXXX")
  chmod 700 -- "$temp_home"
  trap 'safe_remove_query_home "$temp_home"' EXIT
  original=$temp_home/original-auth

  if [[ ${LOCK_HELD:-0} != 1 ]]; then exec 8<>"$LOCK_FILE"; flock -x 8; fi
  install -m 600 -- "$stored" "$temp_home/auth.json"
  install -m 600 -- "$stored" "$original"
  printf '%s\n' 'cli_auth_credentials_store = "file"' > "$temp_home/config.toml"
  chmod 600 -- "$temp_home/config.toml"
  if [[ ${LOCK_HELD:-0} != 1 ]]; then flock -u 8; fi

  set +e
  query_output=$(CODEX_HOME=$temp_home CODEX_BIN=$CODEX_BIN "$QUERY_BIN" "$mode" 2>/dev/null)
  query_status=$?
  set -e

  if [[ ${LOCK_HELD:-0} != 1 ]]; then flock -x 8; fi
  status=$(jq -r '.status // "OK"' <<<"$query_output" 2>/dev/null || printf 'CHECK FAILED')
  if [[ $status == OK ]]; then
    if ! wait_for_auth_file "$temp_home/auth.json"; then
      status='CHECK FAILED'
      query_output=$(jq -c '.status = "CHECK FAILED" | .windows = []' <<<"$query_output")
    fi
  fi
  if [[ $status == OK ]] && ! cmp -s -- "$temp_home/auth.json" "$original"; then
    if cmp -s -- "$stored" "$original"; then
      atomic_install "$temp_home/auth.json" "$stored"
    fi
  fi
  if [[ $status == OK ]]; then
    current=$(read_active 2>/dev/null || true)
    if [[ $current == "$number" ]]; then atomic_install "$stored" "$AUTH_FILE"; fi
  fi

  if (( query_status == 0 )) && query_result_is_safe <<<"$query_output"; then
    query_output=$(finalize_query_result "$number" "$query_output")
  else
    query_status=1
  fi
  if [[ ${LOCK_HELD:-0} != 1 ]]; then flock -u 8; exec 8>&-; fi

  if (( query_status != 0 )); then
    cached=$(metadata_fallback "$number")
    jq -c '. + {status:"CHECK FAILED",windows:[]}' <<<"$cached"
    return 0
  fi
  printf '%s\n' "$query_output"
)

query_account() {
  query_account_isolated "$1" "$2"
}

metadata_fallback() {
  local number=$1 metadata=$ACCOUNT_STORE/$1/metadata.json output normalized_email
  if [[ -f $metadata && ! -L $metadata ]] && jq -e '
      type == "object" and
      (.email == null or (.email | type == "string")) and
      (.planType == null or (.planType | type == "string"))
    ' "$metadata" >/dev/null 2>&1; then
    output=$(jq -c '{accountType:(.accountType // null),email:(.email // null),planType:(.planType // null),status:(.status // "CHECK FAILED"),windows:[]}' "$metadata")
    normalized_email=$(normalize_email "$(jq -r '.email // empty' <<<"$output")")
    jq -c --arg email "$normalized_email" '.email = (if $email == "" then null else $email end)' <<<"$output"
  else
    printf '%s\n' '{"accountType":null,"email":null,"planType":null,"status":"CHECK FAILED","windows":[]}'
  fi
}

health_info() {
  local number=$1 mode=${2-health}
  query_account "$number" "$mode"
}

account_info() {
  local number=$1 mode=$2 result
  if result=$(query_account "$number" "$mode"); then
    printf '%s\n' "$result"
  else
    metadata_fallback "$number"
  fi
}

switch_account() {
  local raw=${1-} target current target_auth status info email health_status
  validate_account "$raw"
  target=$REPLY
  [[ -n $CODEX_BIN && -x $CODEX_BIN ]] || die 'Codex CLI is not executable'
  [[ -d $SHARED_HOME && ! -L $SHARED_HOME ]] || die 'shared Codex home is missing or unsafe'
  ensure_private_store

  exec 9<>"$LOCK_FILE"
  flock -x 9
  LOCK_HELD=1
  current=$(reconcile_live_account)
  target_auth=$ACCOUNT_STORE/$target/auth.json

  if [[ -e $target_auth || -L $target_auth ]]; then
    require_regular_not_symlink "$target_auth" 'stored account authentication'
    if [[ ! -s $target_auth ]]; then
      info=$(metadata_fallback "$target")
      health_status='INVALID AUTH'
    else
      info=$(health_info "$target" health)
      health_status=$(jq -r '.status' <<<"$info")
    fi
    case "$health_status" in
      OK)
        atomic_install "$target_auth" "$AUTH_FILE"
        verify_live_identity "$info" || die 'STATE MISMATCH: installed account identity verification failed'
        atomic_write_text "$target" "$ACTIVE_FILE"
        ;;
      'SIGNED OUT'|'INVALID AUTH'|'SERVER INVALIDATED')
        backup_existing "$target_auth"
        set +e
        perform_new_login "$target"
        status=$?
        set -e
        if (( status != 0 )); then
          flock -u 9
          exec 9>&-
          die 'device authentication failed; previous account restored'
        fi
        info=
        ;;
      'CHECK FAILED')
        flock -u 9
        exec 9>&-
        die 'account authentication check failed; try again later'
        ;;
      *) die 'account authentication check returned an invalid status' ;;
    esac
  else
    set +e
    perform_new_login "$target"
    status=$?
    set -e
    if (( status != 0 )); then
      flock -u 9
      exec 9>&-
      die 'device authentication failed; previous account restored'
    fi
  fi

  flock -u 9
  exec 9>&-
  LOCK_HELD=0
  ensure_account_wrappers "$target"
  if [[ -z ${info:-} ]]; then info=$(account_info "$target" account); fi
  email=$(jq -r '.email // empty' <<<"$info")
  printf 'Active Codex account: %s\n' "$target"
  printf 'Email: %s\n' "$(email_label "$email")"
}

list_account_numbers() {
  local path name
  local -a accounts=()
  [[ -d $ACCOUNT_STORE && ! -L $ACCOUNT_STORE ]] || return 0
  shopt -s nullglob
  for path in "$ACCOUNT_STORE"/*; do
    [[ -d $path && ! -L $path && -f $path/auth.json && ! -L $path/auth.json ]] || continue
    name=${path##*/}
    [[ $name =~ ^[1-9][0-9]*$ ]] || continue
    accounts+=("$name")
  done
  ((${#accounts[@]} > 0)) || return 0
  printf '%s\n' "${accounts[@]}" | sort -n
}

account_slots() {
  list_account_numbers
}

plan_label() {
  case ${1-} in
    free) printf 'ChatGPT Free' ;;
    go) printf 'ChatGPT Go' ;;
    plus) printf 'ChatGPT Plus' ;;
    pro) printf 'ChatGPT Pro' ;;
    prolite) printf 'ChatGPT Pro Lite' ;;
    team) printf 'ChatGPT Team' ;;
    business|self_serve_business_prolite|self_serve_business_usage_based) printf 'ChatGPT Business' ;;
    ent26|enterprise|enterprise_cbp_automation|enterprise_cbp_usage_based) printf 'ChatGPT Enterprise' ;;
    edu|edu_plus|edu_pro) printf 'ChatGPT Edu' ;;
    *) printf 'Unknown plan' ;;
  esac
}

email_label() {
  local email=${1-}
  email=$(normalize_email "$email")
  if [[ -n $email ]]; then
    printf '%s' "$email"
  else
    printf 'Unknown email'
  fi
}

show_list() {
  local active number info email plan line prefix status
  active=$(read_active)
  printf 'Codex Accounts\n\n'
  while IFS= read -r number; do
    [[ -n $number ]] || continue
    if [[ ! -f $ACCOUNT_STORE/$number/auth.json || -L $ACCOUNT_STORE/$number/auth.json ]]; then
      printf '%s  Not registered\n' "$number"
      continue
    fi
    info=$(health_info "$number" health)
    email=$(jq -r '.email // empty' <<<"$info")
    plan=$(jq -r '.planType // empty' <<<"$info")
    status=$(jq -r '.status' <<<"$info")
    prefix="$number"
    if [[ $number == "$active" ]]; then
      if colors_enabled; then prefix=$'\033[32m● '"$number"$'\033[0m'; else prefix="● $number"; fi
    fi
    line="$prefix  $(email_label "$email")  $(plan_label "$plan")  $(render_status "$status")"
    printf '%s\n' "$line"
  done < <(account_slots)
}

render_status() {
  local status=$1 code
  if ! colors_enabled; then printf '%s' "$status"; return; fi
  case "$status" in
    OK) code=32 ;;
    'SIGNED OUT'|'INVALID AUTH'|'SERVER INVALIDATED') code=31 ;;
    *) code=33 ;;
  esac
  printf '\033[%sm%s\033[0m' "$code" "$status"
}

format_countdown() {
  local epoch=${1-} now diff days hours minutes
  [[ $epoch =~ ^[0-9]+$ ]] || { printf 'N/A'; return; }
  now=${CODEX_NOW_EPOCH:-$(date +%s)}
  [[ $now =~ ^[0-9]+$ ]] || now=$(date +%s)
  diff=$((epoch - now))
  (( diff > 0 )) || { printf '0m'; return; }
  days=$((diff / 86400))
  hours=$(((diff % 86400) / 3600))
  minutes=$(((diff % 3600) / 60))
  if (( days > 0 )); then
    printf '%dd %dh' "$days" "$hours"
  elif (( hours > 0 )); then
    printf '%dh %dm' "$hours" "$minutes"
  else
    printf '%dm' "$minutes"
  fi
}

window_json() {
  local info=$1 duration=$2
  jq -c --argjson duration "$duration" '[.windows[] | select(.windowDurationMins == $duration)][0] // null' <<<"$info"
}

print_limit_long() {
  local label=$1 window=$2 used reset remaining
  if [[ $window == null ]]; then
    printf '%s: %s N/A\n' "$label" "$(render_na_bar)"
    printf 'Reset in: N/A\n'
    return
  fi
  used=$(jq -r '.usedPercent' <<<"$window")
  reset=$(jq -r '.resetsAt // empty' <<<"$window")
  remaining=$((100 - used))
  (( remaining < 0 )) && remaining=0
  (( remaining > 100 )) && remaining=100
  printf '%s: %s %s%% left\n' "$label" "$(render_bar "$remaining")" "$remaining"
  printf 'Reset in: %s\n' "$(format_countdown "$reset")"
}

colors_enabled() {
  (( OUTPUT_IS_TTY == 1 )) && [[ ! -v NO_COLOR ]]
}

color_code() {
  local remaining=$1
  if (( remaining >= 80 )); then printf 46
  elif (( remaining >= 60 )); then printf 118
  elif (( remaining >= 40 )); then printf 226
  elif (( remaining >= 20 )); then printf 208
  else printf 196
  fi
}

render_bar() {
  local remaining=$1 filled empty fill_text empty_text code
  (( remaining < 0 )) && remaining=0
  (( remaining > 100 )) && remaining=100
  filled=$(((remaining * 20 + 50) / 100))
  empty=$((20 - filled))
  printf -v fill_text '%*s' "$filled" ''
  fill_text=${fill_text// /█}
  printf -v empty_text '%*s' "$empty" ''
  empty_text=${empty_text// /-}
  if colors_enabled; then
    code=$(color_code "$remaining")
    printf '[\033[38;5;%sm%s\033[0m\033[38;5;88m%s\033[0m]' "$code" "$fill_text" "$empty_text"
  else
    printf '[%s%s]' "$fill_text" "$empty_text"
  fi
}

render_na_bar() {
  if colors_enabled; then printf '[\033[90m????????????????????\033[0m]'; else printf '[????????????????????]'; fi
}

show_usage() {
  local short=0 target= argument number output_dir index=0 failed=0 pid
  local -a numbers=() pids=()
  while (($# > 0)); do
    argument=$1
    shift
    case "$argument" in
      --short) ((short == 0)) || die 'duplicate --short option'; short=1 ;;
      *)
        [[ -z $target ]] || die 'usage: cusage [--short] [N]'
        validate_account "$argument"
        target=$REPLY
        ;;
    esac
  done

  (( short == 1 )) || printf 'Codex Usage\n\n'
  if [[ -n $target ]]; then
    print_usage_account "$target" "$short"
  else
    while IFS= read -r number; do [[ -n $number ]] && numbers+=("$number"); done < <(account_slots)
    ((${#numbers[@]} > 0)) || return 0
    output_dir=$(mktemp -d /tmp/codex-usage.XXXXXX)
    chmod 700 -- "$output_dir"
    trap 'safe_remove_usage_dir "$output_dir"' RETURN
    for number in "${numbers[@]}"; do
      index=$((index + 1))
      (print_usage_account "$number" "$short" > "$output_dir/$index") &
      pids+=("$!")
    done
    for pid in "${pids[@]}"; do wait "$pid" || failed=1; done
    (( failed == 0 )) || die 'one or more account usage checks failed'
    for ((index=1; index<=${#numbers[@]}; index++)); do command cat "$output_dir/$index"; done
    safe_remove_usage_dir "$output_dir"
    trap - RETURN
  fi
}

safe_remove_usage_dir() {
  local path=$1
  case "$path" in
    /tmp/codex-usage.*)
      [[ -d $path && ! -L $path ]] && rm -rf -- "$path"
      ;;
  esac
}

print_usage_account() {
  local number=$1 short=$2 info email plan five weekly five_text week_text active heading status
  if [[ ! -f $ACCOUNT_STORE/$number/auth.json || -L $ACCOUNT_STORE/$number/auth.json ]]; then
    if (( short == 1 )); then
      printf '%s | NOT REGISTERED\n' "$number"
    else
      printf 'Account %s\nNot registered\n\n' "$number"
    fi
    return
  fi

  info=$(health_info "$number" usage)
  email=$(jq -r '.email // empty' <<<"$info")
  plan=$(jq -r '.planType // empty' <<<"$info")
  status=$(jq -r '.status' <<<"$info")
  if [[ $status != OK ]]; then
    if (( short == 1 )); then
      printf '%s %s  %s\n' "$number" "$(email_label "$email")" "$status"
    else
      printf 'Account %s [%s]\n' "$number" "$status"
      printf 'Email: %s\n' "$(email_label "$email")"
      case "$status" in
        'SIGNED OUT'|'INVALID AUTH'|'SERVER INVALIDATED') printf 'Status: Login required\n\n' ;;
        *) printf 'Status: Unable to verify account\n\n' ;;
      esac
    fi
    return
  fi
  five=$(window_json "$info" 300)
  weekly=$(window_json "$info" 10080)
  active=$(read_active 2>/dev/null || true)

  if (( short == 1 )); then
    if [[ $five == null ]]; then five_text="$(render_na_bar) N/A"; else local f=$((100 - $(jq -r '.usedPercent' <<<"$five"))); five_text="$(render_bar "$f") $f%"; fi
    if [[ $weekly == null ]]; then week_text="$(render_na_bar) N/A"; else local w=$((100 - $(jq -r '.usedPercent' <<<"$weekly"))); week_text="$(render_bar "$w") $w%"; fi
    printf '%s %s  5h %s  week %s\n' "$number" "$(email_label "$email")" "$five_text" "$week_text"
    return
  fi

  heading="Account $number"
  [[ $number == "$active" ]] && heading+=' [ACTIVE]'
  printf '%s\n' "$heading"
  printf 'Email: %s\n' "$(email_label "$email")"
  printf 'Plan: %s\n' "$(plan_label "$plan")"
  print_limit_long '5-hour' "$five"
  print_limit_long 'Weekly' "$weekly"
  printf '\n'
}

show_help() {
  if colors_enabled; then printf '\033[1;36mCodex Account Manager\033[0m\n\n'; else printf 'Codex Account Manager\n\n'; fi
  printf '%s\n' \
    'Accounts' \
    'cN / CN       Switch/login Codex account' \
    'clist          Check and show linked accounts' '' \
    'Usage' \
    'cusage         Show usage for all accounts' \
    'cusage N       Show usage for account N' \
    'cusage --short Compact usage' '' \
    'Codex' \
    'codex          Start Codex CLI' \
    'cshare         Share one Codex session across SSH devices' \
    'codex resume   Choose previous session' \
    'codex resume --last' \
    '               Resume last session' '' \
    'Permissions' \
    'Full Access    Enabled globally' '' \
    'Important' \
    'Account switching does NOT restart VS Code'
}

main() {
  local invoked=${0##*/} operation number
  case "$invoked" in
    clist) operation=list ;;
    cusage) operation=usage ;;
    chelp) operation=help ;;
    cswitch) operation=switch ;;
    *) operation=${1-}; [[ $# -eq 0 ]] || shift ;;
  esac

  case "$operation" in
    switch)
      [[ $# -eq 1 ]] || die 'usage: cswitch N'
      switch_account "$1"
      ;;
    refresh-active)
      [[ $# -eq 0 ]] || die 'usage: codex-account-switch refresh-active'
      number=$(read_active)
      local result
      result=$(query_account_shared "$number" health) || die 'active account check failed'
      [[ $(jq -r '.status' <<<"$result") == OK ]] || die 'active account is not authenticated'
      ;;
    list)
      [[ $# -eq 0 ]] || die 'usage: clist'
      show_list
      ;;
    usage)
      show_usage "$@"
      ;;
    help)
      [[ $# -eq 0 ]] || die 'usage: chelp'
      show_help
      ;;
    ensure-wrappers)
      [[ $# -eq 1 ]] || die 'usage: codex-account-switch ensure-wrappers N'
      validate_account "$1"
      ensure_account_wrappers "$REPLY"
      ;;
    *)
      die 'usage: codex-account-switch {switch N|who|list|usage|check|help}'
      ;;
  esac
}

main "$@"
