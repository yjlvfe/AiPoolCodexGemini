[Unit]
Description=AI Suite - Gemini / Antigravity Gateway Bridge (Port 8123)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Projects/AiPoolCodexGemini/bridges
ExecStart=/usr/bin/python3 /root/Projects/AiPoolCodexGemini/bridges/gemini_bridge.py
Restart=always
RestartSec=3
Environment=AG_BRIDGE_HOST=127.0.0.1
Environment=AG_BRIDGE_PORT=8123

[Install]
WantedBy=default.target
