[Unit]
Description=AiPool - ai-codex-bridge (hardened, staged)
After=network.target

[Service]
Type=simple
User=aipool
Group=aipool
WorkingDirectory=/opt/aipool/bridges
ExecStart=/opt/aipool/.venv/bin/python /opt/aipool/bridges/codex_bridge.py
EnvironmentFile=/etc/aipool/aipool.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aipool /var/log/aipool
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
