[Unit]
Description=AI Suite - Multi-Account Pool Dashboard (Port 8444)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Projects/AiPoolCodexGemini/dashboard
ExecStart=/usr/bin/python3 /root/Projects/AiPoolCodexGemini/dashboard/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
