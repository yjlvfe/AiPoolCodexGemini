# ==============================================================================
# AiPoolCodexGemini - Configuration Template
# ==============================================================================

# Bridge Ports
GEMINI_BRIDGE_PORT=8123
CODEX_BRIDGE_PORT=8124
DASHBOARD_PORT=8444

# Bind Host (127.0.0.1 for local isolation, 0.0.0.0 for public exposure)
BIND_HOST="127.0.0.1"

# Paths
BASE_DIR="/root/Projects/AiPoolCodexGemini"
AG_ACCOUNT_STORE="/root/.antigravity-accounts"
CODEX_ACCOUNT_STORE="/root/.codex-accounts"
AUTH_DB_PATH="/root/Projects/AiPoolCodexGemini/dashboard/auth.db"

# Telegram Bot Authentication (for Magic Link generation)
TG_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TG_AUTHORIZED_USER_ID="YOUR_TELEGRAM_USER_ID"
DASHBOARD_BASE_URL="http://127.0.0.1:8444"
