# Optional local settings. Copy to config.env; never commit that file.
# Defaults adapt to the current HOME and clone location. Do not copy VPS paths.
AG_BRIDGE_PORT=8123
CODEX_BRIDGE_PORT=8124
DASHBOARD_PORT=8444
# Keep bridges loopback-only unless you separately configure authentication.
AG_BRIDGE_HOST=127.0.0.1
CODEX_BRIDGE_HOST=127.0.0.1
# Optional Telegram access bot (uses your own token).
# TG_BOT_TOKEN=YOUR_OWN_TELEGRAM_BOT_TOKEN
# POOL_DASHBOARD_URL=https://YOUR_OWN_DOMAIN/aipool
# Optional overrides; use absolute paths only if you need non-default stores:
# AG_ACCOUNT_STORE=/absolute/path/to/antigravity-accounts
# CODEX_ACCOUNT_STORE=/absolute/path/to/codex-accounts
# CODEX_BIN=/absolute/path/to/codex
# AG_OAUTH_PORT=51121
